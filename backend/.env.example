# Скопируйте в .env и заполните. Сервис работает и без ключа (обоснования — по шаблону).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Источник данных: excel | synthetic | csv
DATA_SOURCE=excel
# Путь от корня проекта (либо абсолютный). Содержит IEK/ и Systeme electric/.
DATA_DIR=.
# Дата расчёта YYYY-MM-DD. Пусто = следующий день после последней продажи.
DATA_AS_OF=
# Допущения о сроках новых заказов, требуют подтверждения поставщиками.
# Даты уже отгруженных товаров читаются отдельно из заголовков Excel.
IEK_LEAD_TIME_DAYS=21
SYSTEME_LEAD_TIME_DAYS=35
# Офлайн-каталог ekt.kz: только дополнительные категории/характеристики/ссылки.
# Во время расчёта сеть не используется. Путь относительно корня проекта.
EKT_CATALOG_ENABLED=true
EKT_CATALOG_PATH=data/ekt/catalog.json
# Параметры расчёта по умолчанию
SERVICE_LEVEL=0.95
REVIEW_PERIOD_DAYS=14

# В продакшне приложение доступно только через HTTPS reverse proxy.
APP_ENV=production
# Указать публичный HTTPS-адрес на сервере; локально оставить пустым.
APP_ORIGIN=
# Явно APP_ENV=development для локального HTTP; реальные пароли не коммитить.
# APP_DB_PATH=/var/lib/umytpa/umytpa.sqlite3
# CORS обычно не нужен: UI и API обслуживаются на одном origin.
CORS_ORIGINS=
JOB_TIMEOUT_SECONDS=600
WORKER_STALE_SECONDS=30
JOB_QUEUE_LIMIT=20
