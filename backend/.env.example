# Скопируйте в .env и заполните. Сервис работает и без ключа (обоснования — по шаблону).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Источник данных: synthetic | csv
DATA_SOURCE=synthetic
# Каталог с CSV-выгрузками 1С (если DATA_SOURCE=csv)
DATA_DIR=./data_1c
# Параметры расчёта по умолчанию
SERVICE_LEVEL=0.95
REVIEW_PERIOD_DAYS=14
