# Install as /etc/umytpa/umytpa.env, mode0640 root:umytpa.
APP_ENV=production
# Set to the real external HTTPS origin (scheme + host, no trailing slash).
APP_ORIGIN=https://orders.example.kz
APP_DB_PATH=/var/lib/umytpa/umytpa.sqlite3
# Contains IEK/ and Systeme electric/; service sandbox makes this directory read-only.
DATA_DIR=/srv/umytpa/data
DATA_SOURCE=excel
DATA_AS_OF=
EKT_CATALOG_ENABLED=true
EKT_CATALOG_PATH=/srv/umytpa/data/ekt/catalog.json
IEK_LEAD_TIME_DAYS=21
SYSTEME_LEAD_TIME_DAYS=35
SERVICE_LEVEL=0.95
REVIEW_PERIOD_DAYS=14
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JOB_TIMEOUT_SECONDS=600
WORKER_STALE_SECONDS=30
JOB_QUEUE_LIMIT=20
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
# Avoid oversized BLAS thread pools for a single calculation process.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
